    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.OpenAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-oss-20b\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an AI assistant that classifies municipal complaints into structured JSON with {category, priority, urgency_keywords}. Return only JSON.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Complaint: {{ $json['Complaint Description'] }}\"\n    }\n  ]\n}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -768,
        96
      ],
      "id": "725f4f25-531b-491a-bcf3-03e51a02b97a",
      "name": "Open AI Categorizer"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n    // Get raw AI JSON string\n    let aiResponseStr = item.json.choices?.[0]?.message?.content || '{}';\n    let aiData = {};\n    let errorMessage = '';\n\n    try {\n        aiData = JSON.parse(aiResponseStr);\n    } catch (e) {\n        errorMessage = 'Failed to parse AI response: ' + e.message;\n        aiData = {};\n    }\n\n    // Extract fields\n    const category = (aiData.category || '').trim();\n    const priority = (aiData.priority || '').trim();\n    const urgencyKeywords = Array.isArray(aiData.urgency_keywords)\n        ? aiData.urgency_keywords.join(', ')\n        : '';\n    let assignedDepartment = (aiData.assigned_department || '').trim();\n\n    // 🧠 Auto-assign department if AI didn’t specify one\n    if (!assignedDepartment) {\n        switch (category.toLowerCase()) {\n            case 'road maintenance':\n                assignedDepartment = 'Public Works';\n                break;\n            case 'power':\n            case 'electricity':\n                assignedDepartment = 'Electricity Department';\n                break;\n            case 'water supply':\n            case 'water leakage':\n                assignedDepartment = 'Water Department';\n                break;\n            case 'sanitation':\n            case 'garbage':\n            case 'waste management':\n                assignedDepartment = 'Sanitation Department';\n                break;\n            case 'health':\n            case 'medical emergency':\n            case 'health facility issues':\n                assignedDepartment = 'Health Department';\n                break;\n            case 'education':\n                assignedDepartment = 'Education Department';\n                break;\n            case 'traffic':\n            case 'road safety':\n                assignedDepartment = 'Traffic Police Department';\n                break;\n            case 'environment':\n            case 'pollution':\n                assignedDepartment = 'Environment Department';\n                break;\n            case 'fire':\n            case 'emergency':\n                assignedDepartment = 'Fire Department';\n                break;\n            case 'housing':\n            case 'building':\n                assignedDepartment = 'Housing Department';\n                break;\n            default:\n                assignedDepartment = 'Under observation';\n        }\n    }\n\n    // Status and date generation\n    const status = assignedDepartment ? 'Assigned' : 'Pending';\n    const processingDate = new Date().toISOString();\n\n    // Check if something is missing\n    if (!category && !priority && !assignedDepartment && !urgencyKeywords && !errorMessage) {\n        errorMessage = 'AI response missing expected fields';\n    }\n\n    console.log('Processed item:', { category, priority, assignedDepartment, errorMessage });\n\n    // Return structured JSON\n    return {\n        json: {\n            'Category(Auto Generated)': category,\n            'Priority(Auto Generated)': priority,\n            'Assigned Department(Auto Generated)': assignedDepartment,\n            'Urgency Keywords(Auto Generated)': urgencyKeywords,\n            'Processing Date(Auto Generated)': processingDate,\n            'Status': status,\n            'Error Message(Auto Generated)': errorMessage\n        }\n    };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        96
      ],
      "id": "73ec1a19-2b10-48ef-a03f-a42ff6860d38",
      "name": "Parse AI Response"
    },
